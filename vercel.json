{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/anthropic/v1/messages",
      "destination": "/api/anthropic"
    }
  ],
  "functions": {
    "api/anthropic.js": {
      "maxDuration": 300
    },
    "api/whatsapp.js": {
      "maxDuration": 300
    },
    "api/atender.js": {
      "maxDuration": 300
    },
    "api/rotina.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/rotina?rodada=manha",
      "schedule": "7 13 * * *"
    },
    {
      "path": "/api/rotina?rodada=tarde",
      "schedule": "7 17 * * *"
    },
    {
      "path": "/api/rotina?rodada=noite",
      "schedule": "7 21 * * *"
    }
  ]
}
